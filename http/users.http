@baseUrl = http://localhost:8080
@contentType = application/json

### Variables — fill after login
@accessToken = <paste_access_token_here>
@refreshToken = <paste_refresh_token_here>


### Register a new user
# @name register
POST {{baseUrl}}/api/users/register
Content-Type: {{contentType}}

{
  "email": "nikita@example.com",
  "password": "strongpassword123",
  "name": "Nikita Vassilenko",
  "phone": "+77001234567",
  "address": {
    "street": "Abay 1",
    "city": "Almaty",
    "zip": "050000",
    "is_default": true
  }
}


### Register — duplicate email (expect 409)
POST {{baseUrl}}/api/users/register
Content-Type: {{contentType}}

{
  "email": "nikita@example.com",
  "password": "anotherpassword",
  "name": "Other",
  "phone": ""
}


### Login
# @name login
POST {{baseUrl}}/api/users/login
Content-Type: {{contentType}}

{
  "email": "nikita@example.com",
  "password": "strongpassword123"
}


### Login — wrong password (expect 401)
POST {{baseUrl}}/api/users/login
Content-Type: {{contentType}}

{
  "email": "nikita@example.com",
  "password": "wrongpassword"
}


### Refresh access token
# @name refresh
POST {{baseUrl}}/api/users/refresh
Content-Type: {{contentType}}

{
  "refresh_token": "{{refreshToken}}"
}


### Refresh — invalid token (expect 401)
POST {{baseUrl}}/api/users/refresh
Content-Type: {{contentType}}

{
  "refresh_token": "this.is.not.a.valid.token"
}


### Get profile  [AUTH]
GET {{baseUrl}}/api/users/profile
Authorization: Bearer {{accessToken}}


### Get profile — no token (expect 401)
GET {{baseUrl}}/api/users/profile


### Get profile — refresh token as bearer (expect 401)
GET {{baseUrl}}/api/users/profile
Authorization: Bearer {{refreshToken}}


### Update profile  [AUTH]
PUT {{baseUrl}}/api/users/profile
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "name": "Nikita V. Updated",
  "phone": "+77009876543"
}


### Add address  [AUTH]
POST {{baseUrl}}/api/users/addresses
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "street": "Dostyk 5",
  "city": "Almaty",
  "zip": "050010",
  "is_default": false
}


### Get addresses  [AUTH]
GET {{baseUrl}}/api/users/addresses
Authorization: Bearer {{accessToken}}


### Delete account  [AUTH]
DELETE {{baseUrl}}/api/users/me
Authorization: Bearer {{accessToken}}