@baseUrl = http://localhost:8080
@contentType = application/json

### Variables — заполни после login
@accessToken = <paste_access_token_here>
@refreshToken = <paste_refresh_token_here>


### 1. Register
# @name register
POST {{baseUrl}}/api/users/register
Content-Type: {{contentType}}

{
  "email": "nikita@example.com",
  "password": "strongpassword123",
  "name": "Nikita Vassilenko",
  "phone": "+77001234567"
}


### 2. Login  →  скопируй access_token и refresh_token в переменные выше
# @name login
POST {{baseUrl}}/api/users/login
Content-Type: {{contentType}}

{
  "email": "nikita@example.com",
  "password": "strongpassword123"
}


### 3. Refresh access token
POST {{baseUrl}}/api/users/refresh
Content-Type: {{contentType}}

{
  "refresh_token": "{{refreshToken}}"
}


### 4. Get profile  [AUTH]
GET {{baseUrl}}/api/users/profile
Authorization: Bearer {{accessToken}}


### 5. Update profile  [AUTH]
PUT {{baseUrl}}/api/users/profile
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "name": "Nikita V. Updated",
  "phone": "+77009876543"
}


### 6. Add address  [AUTH]
POST {{baseUrl}}/api/users/addresses
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "street": "Dostyk 5",
  "city": "Almaty",
  "zip": "050010",
  "is_default": false
}


### 7. Get addresses  [AUTH]
GET {{baseUrl}}/api/users/addresses
Authorization: Bearer {{accessToken}}


### 8. Delete account  [AUTH]
DELETE {{baseUrl}}/api/users/me
Authorization: Bearer {{accessToken}}